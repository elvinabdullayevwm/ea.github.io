</head>

<body>

<header>
  <h1>Luxury Store</h1>
  <nav>
    <a href="index.html">Ana səhifə</a>
    <a href="products.html">Məhsullar</a>
    <a href="#">Əlaqə</a>
  </nav>
</header>

<section class="products">

  <div class="card">
    <img src="img/chanel.jpg">
    <h3>Chanel No.5</h3>
    <p>250 AZN</p>
    <button>Sifariş et</button>
  </div>

  <div class="card">
    <img src="img/dior.jpg">
    <h3>Dior Sauvage</h3>
    <p>220 AZN</p>
    <button>Sifariş et</button>
  </div>

  <div class="card">
    <img src="img/mac.jpg">
    <h3>MAC Lipstick</h3>
    <p>70 AZN</p>
    <button>Sifariş et</button>
  </div>

</section>

</body>
</html>
